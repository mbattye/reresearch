# Required: Claude API key (https://platform.claude.com/settings/keys).
# Not needed locally if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Optional: defaults for writing threads (the model and PDF choice can also be changed in Settings).
# SUMMARY_MODEL=claude-sonnet-5-5
# SUMMARY_EFFORT=medium
# SUMMARY_INPUT=text        # "pdf" sends the whole PDF, figures included, at ~3x the cost
# SUMMARY_BATCH=true        # scheduled runs use the half-price Message Batches API

# Optional: free keys that raise the shared quotas of the discovery sources.
# OPENALEX_API_KEY=         # DOI lookups (https://openalex.org/rest-api)
# S2_API_KEY=               # Semantic Scholar recommendations (https://www.semanticscholar.org/product/api)

# Optional locally, required when deployed: any Postgres URL (e.g. Neon).
# Leave unset to use the embedded PGlite database in .data/.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Required when deployed (the app refuses to run in production without APP_PASSWORD):
# APP_PASSWORD=             # long and unique; sign-in is throttled after 8 wrong attempts per 15 min
# CRON_SECRET=              # random string; Vercel Cron sends it to /api/cron/ingest
# SESSION_SECRET=           # optional random string; rotate it to sign every device out
# MONTHLY_BUDGET_USD=10     # summaries stop for the month at this spend (also set in Settings)
