# --- Writing threads ---------------------------------------------------------------------------
# Readers add their own Anthropic or OpenRouter keys in Settings. This deployment key is only a
# fallback for admins (ADMIN_EMAILS). Not needed locally if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Optional defaults (each reader can change model, effort and PDF reading in Settings).
# SUMMARY_MODEL=claude-sonnet-5-5
# SUMMARY_EFFORT=medium
# SUMMARY_INPUT=text        # "pdf" sends the whole PDF, figures included, at ~3x the cost
# SUMMARY_BATCH=true        # scheduled runs use the half-price Message Batches API (Anthropic keys)
# MONTHLY_BUDGET_USD=10     # default monthly budget per reader

# --- Accounts (required in production; the app refuses to start without them) -----------------
# ADMIN_EMAILS=you@example.com            # comma separated; admins can invite people
# BETTER_AUTH_SECRET=                     # random, 32+ characters; signs sessions
# KEY_ENCRYPTION_SECRET=                  # random, 32+ characters; encrypts readers' API keys.
#                                         # Never change it: stored keys can't be decrypted after.
# BETTER_AUTH_URL=https://your.domain     # optional; defaults to the Vercel production URL

# --- Email (sign-in links) ---------------------------------------------------------------------
# Locally, without RESEND_API_KEY, sign-in links are printed in the server log.
# RESEND_API_KEY=
# EMAIL_FROM=reresearch <signin@your-verified-domain>

# --- Infrastructure ----------------------------------------------------------------------------
# Optional locally (embedded PGlite in .data/), required when deployed: any Postgres URL (e.g. Neon).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# CRON_SECRET=              # random string; Vercel Cron sends it to /api/cron/ingest

# Optional: free keys that raise the shared quotas of the discovery sources.
# OPENALEX_API_KEY=
# S2_API_KEY=
